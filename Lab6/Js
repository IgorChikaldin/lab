const productInput = document.querySelector("#productInput");
const addButton = document.querySelector("#addButton");
const shoppingList = document.querySelector("#shoppingList");
const message = document.querySelector("#message");
const counter = document.querySelector("#counter");
const themeButton = document.querySelector("#themeButton");

function updateCounter() {
    const items = document.querySelectorAll(".shopping-item");
    counter.textContent = `Покупок: ${items.length}`;
}

function addProduct() {
    const productName = productInput.value.trim();

    if (productName === "") {
        message.textContent = "Введите название покупки!";
        return;
    }

    message.textContent = "";

    const listItem = document.createElement("li");
    listItem.classList.add("shopping-item");

    const productInfo = document.createElement("div");
    productInfo.classList.add("product-info");

    const favoriteButton = document.createElement("button");
    favoriteButton.textContent = "☆";
    favoriteButton.classList.add("favorite-button");

    favoriteButton.addEventListener("click", function(event) {
        event.stopPropagation();

        if (favoriteButton.classList.contains("favorite")) {
            favoriteButton.classList.remove("favorite");
            favoriteButton.textContent = "☆";

            shoppingList.appendChild(listItem);
        } else {
            favoriteButton.classList.add("favorite");
            favoriteButton.textContent = "⭐";

            shoppingList.prepend(listItem);
        }
    });

    const productText = document.createElement("span");
    productText.textContent = productName;
    productText.classList.add("product-name");

    const quantity = document.createElement("div");
    quantity.classList.add("quantity");

    const minusButton = document.createElement("button");
    minusButton.textContent = "−";

    const quantityNumber = document.createElement("span");
    quantityNumber.textContent = "1";
    quantityNumber.classList.add("quantity-number");

    const plusButton = document.createElement("button");
    plusButton.textContent = "+";

    minusButton.addEventListener("click", function(event) {
        event.stopPropagation();

        let number = Number(quantityNumber.textContent);

        if (number > 1) {
            number--;
            quantityNumber.textContent = number;
        }
    });

    plusButton.addEventListener("click", function(event) {
        event.stopPropagation();

        let number = Number(quantityNumber.textContent);
        number++;

        quantityNumber.textContent = number;
    });

    quantity.appendChild(minusButton);
    quantity.appendChild(quantityNumber);
    quantity.appendChild(plusButton);

    const deleteButton = document.createElement("button");
    deleteButton.textContent = "Удалить";
    deleteButton.classList.add("delete-button");

    deleteButton.addEventListener("click", function(event) {
        event.stopPropagation();

        listItem.style.animation = "itemAppear 0.3s reverse";

        setTimeout(function() {
            listItem.remove();
            updateCounter();
        }, 250);
    });

    listItem.addEventListener("click", function() {
        listItem.classList.toggle("completed");
    });

    productInfo.appendChild(favoriteButton);
    productInfo.appendChild(productText);

    listItem.appendChild(productInfo);
    listItem.appendChild(quantity);
    listItem.appendChild(deleteButton);

    shoppingList.appendChild(listItem);

    productInput.value = "";

    updateCounter();
}

addButton.addEventListener("click", addProduct);

productInput.addEventListener("keydown", function(event) {
    if (event.key === "Enter") {
        addProduct();
    }
});

themeButton.addEventListener("click", function() {
    document.body.classList.toggle("dark");

    if (document.body.classList.contains("dark")) {
        themeButton.textContent = "☀️";
    } else {
        themeButton.textContent = "🌙";
    }
});
