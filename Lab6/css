* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f1f5f9;
    color: #1e293b;
    transition: background 0.5s, color 0.5s;
}

.container {
    width: 90%;
    max-width: 550px;
    margin: 60px auto;
    padding: 30px;
    background: white;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
    transition: background 0.5s, box-shadow 0.5s;
    animation: appear 0.7s ease;
}

@keyframes appear {
    from {
        opacity: 0;
        transform: translateY(30px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.top-panel {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

h1 {
    margin-bottom: 25px;
}

#themeButton {
    width: 45px;
    height: 45px;
    border: none;
    border-radius: 50%;
    background: #e2e8f0;
    font-size: 20px;
    cursor: pointer;
    transition: 0.3s;
}

#themeButton:hover {
    transform: rotate(20deg) scale(1.1);
}

.input-group {
    display: flex;
    gap: 10px;
}

#productInput {
    flex: 1;
    padding: 12px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-size: 16px;
    outline: none;
}

#productInput:focus {
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
}

#addButton {
    padding: 12px 18px;
    border: none;
    border-radius: 8px;
    background: #2563eb;
    color: white;
    cursor: pointer;
    font-size: 16px;
    transition: 0.3s;
}

#addButton:hover {
    background: #1d4ed8;
    transform: scale(1.05);
}

#message {
    min-height: 20px;
    text-align: center;
    color: #dc2626;
}

#shoppingList {
    list-style: none;
    padding: 0;
    margin-top: 20px;
}

.shopping-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 12px;
    margin-bottom: 10px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    cursor: pointer;
    transition: 0.3s;
    animation: itemAppear 0.4s ease;
}

@keyframes itemAppear {
    from {
        opacity: 0;
        transform: translateX(-20px);
    }

    to {
        opacity: 1;
        transform: translateX(0);
    }
}

.shopping-item:hover {
    background: #e0f2fe;
    transform: translateX(5px);
}

.product-info {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1;
}

.product-name {
    font-size: 16px;
}

.shopping-item.completed {
    background: #dcfce7;
    color: #64748b;
    text-decoration: line-through;
}

.favorite-button {
    border: none;
    background: transparent;
    font-size: 22px;
    cursor: pointer;
    transition: 0.3s;
}

.favorite-button:hover {
    transform: scale(1.3);
}

.favorite-button.favorite {
    animation: favoriteAnimation 0.3s ease;
}

@keyframes favoriteAnimation {
    50% {
        transform: scale(1.5);
    }
}

.quantity {
    display: flex;
    align-items: center;
    gap: 5px;
}

.quantity button {
    width: 28px;
    height: 28px;
    border: none;
    border-radius: 5px;
    background: #2563eb;
    color: white;
    cursor: pointer;
    font-size: 16px;
}

.quantity button:hover {
    background: #1d4ed8;
}

.quantity-number {
    min-width: 25px;
    text-align: center;
    font-weight: bold;
}

.delete-button {
    border: none;
    background: #ef4444;
    color: white;
    padding: 6px 10px;
    border-radius: 6px;
    cursor: pointer;
    transition: 0.3s;
}

.delete-button:hover {
    background: #dc2626;
    transform: scale(1.05);
}

#counter {
    text-align: center;
    font-weight: bold;
    margin-top: 20px;
}


/* НОЧНАЯ ТЕМА */

body.dark {
    background: #0f172a;
    color: #f8fafc;
}

body.dark .container {
    background: #1e293b;
    box-shadow: 0 5px 25px rgba(0, 0, 0, 0.4);
}

body.dark #productInput {
    background: #334155;
    color: white;
    border-color: #475569;
}

body.dark #productInput::placeholder {
    color: #cbd5e1;
}

body.dark .shopping-item {
    background: #334155;
    border-color: #475569;
}

body.dark .shopping-item:hover {
    background: #475569;
}

body.dark .shopping-item.completed {
    background: #14532d;
}

body.dark #themeButton {
    background: #475569;
}
