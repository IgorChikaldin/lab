
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Личный кабинет студента</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

<div class="container">
    <div class="login-box">

        <h1>Личный кабинет</h1>
        <p>Студенческий портал</p>

        <!-- Форма входа -->
        <form id="loginForm">
            <h2>Вход</h2>

            <input type="text" id="login"
                   placeholder="Введите логин" required>

            <input type="password" id="password"
                   placeholder="Введите пароль" required>

            <button type="submit">Войти</button>

            <p>Нет аккаунта?</p>
            <button type="button" id="showRegister"
                    class="secondary">
                Регистрация
            </button>
        </form>

        <!-- Форма регистрации -->
        <form id="registerForm" hidden>
            <h2>Регистрация</h2>

            <input type="text" id="regName"
                   placeholder="Ваше имя" required>

            <input type="text" id="regLogin"
                   placeholder="Придумайте логин" required>

            <input type="password" id="regPassword"
                   placeholder="Придумайте пароль" required>

            <button type="submit">Создать аккаунт</button>

            <p>Уже есть аккаунт?</p>
            <button type="button" id="showLogin"
                    class="secondary">
                Вернуться ко входу
            </button>
        </form>

        <div id="message"></div>

        <!-- Личный кабинет -->
        <div id="profile" hidden>
            <h2>Добро пожаловать!</h2>
            <p id="studentName"></p>
            <button id="logoutBtn">Выйти</button>
        </div>

    </div>
</div>

<script src="script.js"></script>
</body>
</html>

