
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Учёт товаров на складе</title>
    <link rel="stylesheet" href="style.css">
    <script src="script.js" defer></script>
</head>
<body>
    <header class="header">
        <div>
            <h1>СкладПро</h1>
            <p>Система учёта движения товаров</p>
        </div>
        <span class="status">Склад работает</span>
    </header>

    <main class="container">
        <section class="stats">
            <article class="stat-card">
                <span>Всего позиций</span>
                <strong id="totalProducts">0</strong>
            </article>
            <article class="stat-card">
                <span>Единиц на складе</span>
                <strong id="totalQuantity">0</strong>
            </article>
            <article class="stat-card">
                <span>Стоимость запасов</span>
                <strong id="totalValue">0 ₸</strong>
            </article>
        </section>

        <section class="panel">
            <h2>Добавить товар</h2>

            <form id="productForm">
                <div class="form-grid">
                    <label>
                        Название
                        <input id="productName" type="text"
                            placeholder="Например, Ноутбук"
                            maxlength="60" required>
                    </label>

                    <label>
                        Категория
                        <input id="productCategory" type="text"
                            placeholder="Электроника"
                            maxlength="40" required>
                    </label>

                    <label>
                        Количество
                        <input id="productQuantity" type="number"
                            min="1" step="1" placeholder="10" required>
                    </label>

                    <label>
                        Цена за единицу (₸)
                        <input id="productPrice" type="number"
                            min="0.01" step="0.01"
                            placeholder="25000" required>
                    </label>
                </div>

                <button type="submit" class="btn primary">
                    Добавить товар
                </button>
                <p id="formMessage" class="message" aria-live="polite"></p>
            </form>
        </section>

        <section class="panel">
            <div class="section-heading">
                <h2>Складские остатки</h2>
                <input id="searchInput" type="search"
                    placeholder="Поиск по названию или коду">
            </div>

            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>Код</th>
                            <th>Название</th>
                            <th>Категория</th>
                            <th>Количество</th>
                            <th>Цена</th>
                            <th>Стоимость</th>
                            <th>Операции</th>
                        </tr>
                    </thead>
                    <tbody id="productTable"></tbody>
                </table>
            </div>

            <p id="emptyMessage" class="empty-message" hidden>
                Товары не найдены.
            </p>
        </section>

        <section class="panel">
            <div class="section-heading">
                <h2>История операций</h2>
                <button id="clearHistory" class="btn secondary"
                    type="button">
                    Очистить историю
                </button>
            </div>

            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>Дата</th>
                            <th>Операция</th>
                            <th>Товар</th>
                            <th>Количество</th>
                        </tr>
                    </thead>
                    <tbody id="historyTable"></tbody>
                </table>
            </div>
            <p id="historyEmpty" class="empty-message" hidden>
                Операций пока нет.
            </p>
        </section>
    </main>

    <footer>
        СкладПро — учебный проект по логистике
    </footer>
</body>
</html>
