class Book:
    def __init__(self, title, author, year, pages):
        self.title = title
        self.author = author
        self.year = year
        self.pages = pages

    def show_info(self):
        print("Название:", self.title)
        print("Автор:", self.author)
        print("Год:", self.year)
        print("Страницы:", self.pages)


book = Book("Война и мир", "Лев Толстой", 1869, 1225)

book.show_info()
