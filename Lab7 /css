:root {
    --primary: #a34e2b;
    --primary-dark: #78371f;
    --background: #fffaf5;
    --surface: #ffffff;
    --text: #33251f;
    --muted: #806e64;
    --border: #eadfd5;
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: var(--background);
    color: var(--text);
    line-height: 1.6;
}

button {
    font: inherit;
}

.container {
    width: min(1100px, 92%);
    margin: 0 auto;
}

.header {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 10;
}

.header-inner {
    min-height: 68px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
}

.logo {
    font-size: 24px;
    font-weight: bold;
    color: var(--primary);
    text-decoration: none;
}

.cart-info {
    font-weight: bold;
    font-size: 14px;
}

.cart-divider {
    color: var(--border);
    margin: 0 5px;
}

.hero {
    text-align: center;
    padding: 48px 12px 32px;
}

.eyebrow {
    color: var(--primary);
    font-weight: bold;
    font-size: 12px;
    letter-spacing: 2px;
}

.hero h1 {
    font-size: clamp(28px, 5vw, 44px);
    margin: 10px 0;
    line-height: 1.2;
}

.hero p:last-child {
    color: var(--muted);
}

.tabs {
    display: flex;
    justify-content: center;
    gap: 10px;
    padding: 8px;
    margin-bottom: 30px;
    background: #f1e7dd;
    border-radius: 14px;
}

.tab {
    flex: 1;
    max-width: 220px;
    border: 2px solid transparent;
    border-radius: 10px;
    background: transparent;
    color: var(--text);
    padding: 12px 16px;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
}

.tab:hover {
    background: #fff;
}

.tab.active {
    background: var(--primary);
    color: #fff;
    border-color: var(--primary);
    font-weight: bold;
}

.tab:focus-visible,
.add-button:focus-visible {
    outline: 3px solid #e9a66c;
    outline-offset: 3px;
}

.section-title {
    font-size: 28px;
    margin: 0 0 8px;
}

.section-description {
    color: var(--muted);
    margin: 0 0 24px;
}

.menu-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
}

.dish-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
}

.dish-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px #6b422014;
}

.dish-image {
    display: grid;
    place-items: center;
    min-height: 150px;
    background: #f5e8da;
    font-size: 68px;
}

.dish-body {
    padding: 18px;
    display: flex;
    flex-direction: column;
    flex: 1;
}

.dish-body h3 {
    margin: 0 0 8px;
    font-size: 20px;
}

.dish-description {
    margin: 0 0 16px;
    color: var(--muted);
    font-size: 14px;
    flex: 1;
}

.dish-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
}

.price {
    font-size: 18px;
    font-weight: bold;
    color: var(--primary);
}

.add-button {
    background: var(--primary);
    color: white;
    border: none;
    border-radius: 8px;
    padding: 9px 13px;
    cursor: pointer;
}

.add-button:hover {
    background: var(--primary-dark);
}

.promo-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
}

.promo-card,
.info-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 24px;
}

.promo-icon {
    font-size: 38px;
}

.promo-card h3,
.info-card h3 {
    margin: 8px 0;
}

.promo-card p,
.info-card p {
    color: var(--muted);
}

.promo-label {
    display: inline-block;
    background: #f9e8d9;
    color: var(--primary-dark);
    border-radius: 6px;
    padding: 4px 10px;
    font-weight: bold;
    font-size: 13px;
}

.address-layout {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
}

.map-placeholder {
    min-height: 220px;
    display: grid;
    place-items: center;
    text-align: center;
    padding: 20px;
    border-radius: 14px;
    background: #f1e7dd;
    font-size: 18px;
}

.map-placeholder span {
    display: block;
    font-size: 48px;
}

.footer {
    text-align: center;
    color: var(--muted);
    padding: 36px 0 24px;
    font-size: 13px;
}

@media (max-width: 760px) {
    .menu-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .hero {
        padding-top: 32px;
    }
}

@media (max-width: 520px) {
    .header-inner {
        flex-wrap: wrap;
        padding: 12px 0;
    }

    .logo {
        font-size: 21px;
    }

    .cart-info {
        font-size: 12px;
    }

    .tabs {
        gap: 5px;
        padding: 5px;
        margin-bottom: 22px;
    }

    .tab {
        padding: 11px 5px;
        font-size: 13px;
    }

    .menu-grid,
    .promo-grid,
    .address-layout {
        grid-template-columns: 1fr;
    }

    .dish-image {
        min-height: 130px;
    }

    .section-title {
        font-size: 24px;
    }
}
.cart-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.cart-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 20px;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 14px;
}

.cart-item-info {
    min-width: 0;
}

.cart-item-info h3 {
    margin: 0 0 8px;
}

.cart-item-info p {
    margin: 0;
    color: var(--muted);
}

.cart-controls {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
    flex-wrap: wrap;
}

.quantity-button {
    width: 36px;
    height: 36px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--background);
    cursor: pointer;
    font-size: 20px;
}

.quantity {
    min-width: 20px;
    text-align: center;
    font-weight: bold;
}

.remove-button {
    padding: 9px 12px;
    border: none;
    border-radius: 8px;
    background: #fbe7e4;
    color: #a52c20;
    cursor: pointer;
}

.remove-button:hover {
    background: #f5d0ca;
}

.cart-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 24px;
    padding: 20px;
    border-radius: 14px;
    background: #f1e7dd;
}

.cart-summary h3 {
    margin: 0;
    color: var(--primary-dark);
}

@media (max-width: 520px) {
    .cart-item {
        align-items: flex-start;
        flex-direction: column;
    }

    .cart-controls {
        justify-content: flex-start;
    }

    .cart-summary {
        align-items: flex-start;
        flex-direction: column;
    }
}
