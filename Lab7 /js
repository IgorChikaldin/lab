const content = document.getElementById("content");
const tabs = document.querySelectorAll(".tab");
const cartCount = document.getElementById("cart-count");
const cartTotal = document.getElementById("cart-total");

const cart = new Map();

let currentTab = "menu";

function formatPrice(price) {
    return price.toLocaleString("ru-RU") + " ₸";
}

function updateCart() {
    let count = 0;
    let total = 0;

    cart.forEach((quantity, id) => {
        const dish = dishes.find(item => item.id === id);

        if (dish) {
            count += quantity;
            total += dish.price * quantity;
        }
    });

    cartCount.textContent = count;
    cartTotal.textContent = formatPrice(total);
}

function renderMenu() {
    content.replaceChildren();

    const title = document.createElement("h2");
    title.className = "section-title";
    title.textContent = "Наше меню";

    const description = document.createElement("p");
    description.className = "section-description";
    description.textContent =
        "Выбирайте любимые блюда и добавляйте их в корзину.";

    const grid = document.createElement("div");
    grid.className = "menu-grid";

    dishes.forEach(dish => {
        const card = document.createElement("article");
        card.className = "dish-card";

        const image = document.createElement("div");
        image.className = "dish-image";
        image.setAttribute("aria-hidden", "true");
        image.textContent = dish.emoji;

        const body = document.createElement("div");
        body.className = "dish-body";

        const name = document.createElement("h3");
        name.textContent = dish.name;

        const text = document.createElement("p");
        text.className = "dish-description";
        text.textContent = dish.description;

        const bottom = document.createElement("div");
        bottom.className = "dish-bottom";

        const price = document.createElement("span");
        price.className = "price";
        price.textContent = formatPrice(dish.price);

        const button = document.createElement("button");
        button.className = "add-button";
        button.textContent = "В корзину";

        button.addEventListener("click", () => {
            const quantity = cart.get(dish.id) || 0;
            cart.set(dish.id, quantity + 1);

            updateCart();

            button.textContent = "Добавлено ✓";

            setTimeout(() => {
                button.textContent = "В корзину";
            }, 1000);
        });

        bottom.append(price, button);
        body.append(name, text, bottom);
        card.append(image, body);
        grid.append(card);
    });

    content.append(title, description, grid);
}

