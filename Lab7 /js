function renderCart() {
    content.replaceChildren();

    const title = document.createElement("h2");
    title.className = "section-title";
    title.textContent = "Ваша корзина";

    const description = document.createElement("p");
    description.className = "section-description";
    description.textContent =
        "Здесь находятся выбранные вами блюда.";

    content.append(title, description);

    if (cart.size === 0) {
        const empty = document.createElement("p");
        empty.className = "info-card";
        empty.textContent =
            "🛒 Корзина пуста. Добавьте блюда из меню!";

        content.append(empty);
        return;
    }

    const grid = document.createElement("div");
    grid.className = "cart-list";

    let total = 0;

    cart.forEach((quantity, id) => {
        const dish = dishes.find(item => item.id === id);

        if (!dish) return;

        total += dish.price * quantity;

        const card = document.createElement("article");
        card.className = "cart-item";

        const info = document.createElement("div");
        info.className = "cart-item-info";

        const name = document.createElement("h3");
        name.textContent = `${dish.emoji} ${dish.name}`;

        const price = document.createElement("p");
        price.textContent =
            `${formatPrice(dish.price)} × ${quantity} = ` +
            formatPrice(dish.price * quantity);

        info.append(name, price);

        const controls = document.createElement("div");
        controls.className = "cart-controls";

        const minus = document.createElement("button");
        minus.className = "quantity-button";
        minus.textContent = "−";
        minus.setAttribute(
            "aria-label",
            `Уменьшить количество: ${dish.name}`
        );

        minus.addEventListener("click", () => {
            if (quantity <= 1) {
                cart.delete(id);
            } else {
                cart.set(id, quantity - 1);
            }

            updateCart();
            renderCart();
        });

        const count = document.createElement("span");
        count.className = "quantity";
        count.textContent = quantity;

        const plus = document.createElement("button");
        plus.className = "quantity-button";
        plus.textContent = "+";
        plus.setAttribute(
            "aria-label",
            `Увеличить количество: ${dish.name}`
        );

        plus.addEventListener("click", () => {
            cart.set(id, quantity + 1);
            updateCart();
            renderCart();
        });

        const remove = document.createElement("button");
        remove.className = "remove-button";
        remove.textContent = "Удалить";

        remove.addEventListener("click", () => {
            cart.delete(id);
            updateCart();
            renderCart();
        });

        controls.append(minus, count, plus, remove);
        card.append(info, controls);
        grid.append(card);
    });

    const summary = document.createElement("div");
    summary.className = "cart-summary";

    const totalText = document.createElement("h3");
    totalText.textContent = `Итого: ${formatPrice(total)}`;

    const clearButton = document.createElement("button");
    clearButton.className = "remove-button";
    clearButton.textContent = "Очистить корзину";

    clearButton.addEventListener("click", () => {
        cart.clear();
        updateCart();
        renderCart();
    });

    summary.append(totalText, clearButton);
    content.append(grid, summary);
}

function switchTab(tabName) {
    currentTab = tabName;

    tabs.forEach(tab => {
        const isActive = tab.dataset.tab === tabName;

        tab.classList.toggle("active", isActive);
        tab.setAttribute("aria-selected", String(isActive));
    });

    if (tabName === "menu") {
        renderMenu();
    } else if (tabName === "promotions") {
        renderPromotions();
    } else if (tabName === "address") {
        renderAddress();
    } else if (tabName === "cart") {
        renderCart();
    }
}

tabs.forEach(tab => {
    tab.addEventListener("click", () => {
        switchTab(tab.dataset.tab);
    });
});

switchTab(currentTab);
updateCart();
